VNSTOCK_API_KEY=replace_with_your_key
APP_ENV=development
LOG_LEVEL=INFO
PROVIDER_SLEEP_SECONDS=2.1
MAX_LIVE_PROVIDER_CALLS=40
DAILY_BACKFILL_CHUNK_CALENDAR_DAYS=730
LIQUIDITY_WINDOW_WEEKDAYS=20
LIQUIDITY_MIN_HISTORY_OBSERVATIONS=15
LIQUIDITY_MIN_TRADING_FREQUENCY=0.8
LIQUIDITY_MAX_ZERO_VOLUME_FREQUENCY=0.2
DAILY_COVERAGE_MIN_HISTORY_OBSERVATIONS=500
DAILY_COVERAGE_MIN_SPAN_RATIO=0.9
DAILY_COVERAGE_STALE_AFTER_DAYS=7
DAILY_COVERAGE_MAX_ZERO_VOLUME_FREQUENCY=0.2
